# ==========================
# Core Application
# ==========================
APP_NAME=MindGuard
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=please-change-me-in-production
AI_MODEL_STRATEGY=hybrid
DEEP_MODEL_CHECKPOINT=models/deep_multimodal_fusion.pt
DEEP_MODEL_DEVICE=cpu
DEEP_MODEL_ALLOW_RANDOM_INIT=false
DEEP_MODEL_BLEND_ALPHA=0.65

# ==========================
# Web/API Ports
# ==========================
WEB_PORT=30000
BACKEND_PORT=8000
NGINX_HTTP_PORT=30000
NGINX_HTTPS_PORT=30443
NGINX_CONF_FILE=nginx.dev.conf

# ==========================
# MySQL
# ==========================
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=cognitive_root_2026
MYSQL_DATABASE=cognitive_db
MYSQL_USER=cognitive_user
MYSQL_PASSWORD=cognitive_pass_2026

# ==========================
# Redis
# ==========================
REDIS_PORT=6379

# ==========================
# Celery Beat Reminders
# ==========================
CELERY_BEAT_ENABLED=true
CELERY_BEAT_ADHERENCE_INTERVAL_MINUTES=30
CELERY_BEAT_ADHERENCE_DUE_ONLY=true
CELERY_BEAT_REASSESSMENT_INTERVAL_MINUTES=120
CELERY_BEAT_REASSESSMENT_WITHIN_DAYS=7

# ==========================
# WeChat Subscription Message
# ==========================
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_TEMPLATE_ID_ADHERENCE=
WECHAT_TEMPLATE_ID_REASSESSMENT=
WECHAT_MINIPROGRAM_PAGE=pages/index/index
WECHAT_MOCK_MODE=false

# ==========================
# MinIO
# ==========================
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=cognitive_admin
MINIO_ROOT_PASSWORD=cognitive_minio_2026
MINIO_BUCKET=cognitive-files

# ==========================
# InfluxDB
# ==========================
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=cognitive_influx_2026
INFLUXDB_ORG=cognitive-org
INFLUXDB_BUCKET=behavior-data
INFLUXDB_TOKEN=cognitive_influx_token_2026

# ==========================
# MongoDB
# ==========================
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=cognitive_mongo_2026
MONGO_INITDB_DATABASE=cognitive_features
